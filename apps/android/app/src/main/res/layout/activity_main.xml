<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-in / classes / hand-off screens scroll in a centred column (max width,
     MainActivity.applyResponsiveLayout). The in-class screen (classScreen) is a
     full-window layout: an icon rail plus the video column, with chat and the
     roster opening as a side panel (landscape / wide) or a bottom sheet. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

<ScrollView
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/appTitle"
                style="@style/Wide"
                android:text="Classroom"
                android:textColor="#F8FAFC"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/appSubtitle"
                style="@style/Body"
                android:paddingBottom="12dp"
                android:text="Teacher app. Share this device's screen and speak to your class."
                android:textColor="#94A3B8" />

            <!-- Sign in -->
            <LinearLayout
                android:id="@+id/loginGroup"
                style="@style/Wide"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/serverInput"
                    style="@style/Field"
                    android:hint="Server address"
                    android:importantForAutofill="no"
                    android:inputType="textUri" />

                <EditText
                    android:id="@+id/emailInput"
                    style="@style/Field"
                    android:hint="Email"
                    android:autofillHints="emailAddress"
                    android:inputType="textEmailAddress" />

                <EditText
                    android:id="@+id/passwordInput"
                    style="@style/Field"
                    android:hint="Password"
                    android:autofillHints="password"
                    android:inputType="textPassword" />

                <Button
                    android:id="@+id/loginButton"
                    style="@style/Wide"
                    android:text="Sign in" />

                <TextView
                    style="@style/Body"
                    android:paddingTop="8dp"
                    android:text="Signing in here signs you out of the website and any other device."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Home: running class, today's timetable, extra (ad-hoc) class -->
            <LinearLayout
                android:id="@+id/homeGroup"
                style="@style/Wide"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/helloText"
                    style="@style/Body"
                    android:textColor="#E2E8F0"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/activeCard"
                    style="@style/Card"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/activeText"
                        style="@style/Body"
                        android:textColor="#86EFAC" />

                    <Button
                        android:id="@+id/rejoinButton"
                        style="@style/Wide"
                        android:text="Rejoin live class" />
                </LinearLayout>

                <TextView
                    style="@style/Heading"
                    android:text="Today's classes" />

                <LinearLayout
                    android:id="@+id/todayList"
                    style="@style/Wide"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Heading"
                    android:text="Start an extra class" />

                <LinearLayout
                    android:id="@+id/adhocCard"
                    style="@style/Card">

                    <Spinner
                        android:id="@+id/gradeSpinner"
                        style="@style/Field" />

                    <Spinner
                        android:id="@+id/divisionSpinner"
                        style="@style/Field" />

                    <EditText
                        android:id="@+id/subjectInput"
                        style="@style/Field"
                        android:hint="Subject (optional)"
                        android:importantForAutofill="no"
                        android:inputType="textCapWords" />

                    <Button
                        android:id="@+id/adhocButton"
                        style="@style/Wide"
                        android:text="Start extra class" />
                </LinearLayout>

                <TextView
                    android:id="@+id/noGradesText"
                    style="@style/Body"
                    android:text="No grades are assigned to you yet. Ask the school admin."
                    android:visibility="gone" />

                <LinearLayout
                    style="@style/Wide"
                    android:orientation="horizontal"
                    android:paddingTop="12dp">

                    <Button
                        android:id="@+id/refreshButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Refresh" />

                    <Button
                        android:id="@+id/logoutButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Sign out" />
                </LinearLayout>
            </LinearLayout>

            <!-- This device lost the class to another connection -->
            <LinearLayout
                android:id="@+id/handoffGroup"
                style="@style/Card"
                android:visibility="gone">

                <TextView
                    android:id="@+id/handoffTitle"
                    style="@style/Wide"
                    android:text="Class continued on another device"
                    android:textColor="#F8FAFC"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/handoffText"
                    style="@style/Body"
                    android:paddingTop="6dp"
                    android:paddingBottom="8dp"
                    android:text="This class was opened with your account on another device or tab, so this one was disconnected. The class itself carries on there." />

                <Button
                    android:id="@+id/useHereButton"
                    style="@style/Wide"
                    android:text="Use this device instead" />

                <Button
                    android:id="@+id/handoffHomeButton"
                    style="@style/Wide"
                    android:text="Back to classes" />
            </LinearLayout>

            <TextView
                android:id="@+id/errorText"
                style="@style/Body"
                android:paddingTop="12dp"
                android:textColor="#FCA5A5" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>

    <!-- In class -->
    <FrameLayout
        android:id="@+id/classScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/classRow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Icon rail: one narrow column, scrolls on short screens. -->
            <ScrollView
                android:id="@+id/railScroll"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="#0B1220"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/rail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp" />
            </ScrollView>

            <!-- Video column -->
            <LinearLayout
                android:id="@+id/mainArea"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/classTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#F8FAFC"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/classStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <!-- Waiting room banner (tap: open the roster). -->
                <LinearLayout
                    android:id="@+id/waitingBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_waiting"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/waitingText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#FDE68A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/admitAllButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#F59E0B"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="40dp"
                        android:text="Admit all"
                        android:textAllCaps="false"
                        android:textColor="#000000" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/videoArea"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Side panel host (landscape / wide windows). -->
            <FrameLayout
                android:id="@+id/sidePanelHost"
                android:layout_width="360dp"
                android:layout_height="match_parent"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Bottom sheet host (portrait phones) with a scrim. -->
        <FrameLayout
            android:id="@+id/sheetHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:clickable="true"
            android:focusable="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/classToast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginStart="88dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:accessibilityLiveRegion="assertive"
            android:background="@drawable/bg_toast"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
