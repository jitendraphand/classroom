<?xml version="1.0" encoding="utf-8"?>
<!-- One layout for phones and tablets, portrait and landscape: the content is
     centred with a maximum width, and in class the controls and the chat sit
     side by side when the window is wide (MainActivity.applyResponsiveLayout). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/appTitle"
                style="@style/Wide"
                android:text="Classroom"
                android:textColor="#F8FAFC"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/appSubtitle"
                style="@style/Body"
                android:paddingBottom="12dp"
                android:text="Teacher app. Share this device's screen and speak to your class."
                android:textColor="#94A3B8" />

            <!-- Sign in -->
            <LinearLayout
                android:id="@+id/loginGroup"
                style="@style/Wide"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/serverInput"
                    style="@style/Field"
                    android:hint="Server address"
                    android:importantForAutofill="no"
                    android:inputType="textUri" />

                <EditText
                    android:id="@+id/emailInput"
                    style="@style/Field"
                    android:hint="Email"
                    android:autofillHints="emailAddress"
                    android:inputType="textEmailAddress" />

                <EditText
                    android:id="@+id/passwordInput"
                    style="@style/Field"
                    android:hint="Password"
                    android:autofillHints="password"
                    android:inputType="textPassword" />

                <Button
                    android:id="@+id/loginButton"
                    style="@style/Wide"
                    android:text="Sign in" />

                <TextView
                    style="@style/Body"
                    android:paddingTop="8dp"
                    android:text="Signing in here signs you out of the website and any other device."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Home: running class, today's timetable, extra (ad-hoc) class -->
            <LinearLayout
                android:id="@+id/homeGroup"
                style="@style/Wide"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/helloText"
                    style="@style/Body"
                    android:textColor="#E2E8F0"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/activeCard"
                    style="@style/Card"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/activeText"
                        style="@style/Body"
                        android:textColor="#86EFAC" />

                    <Button
                        android:id="@+id/rejoinButton"
                        style="@style/Wide"
                        android:text="Rejoin live class" />
                </LinearLayout>

                <TextView
                    style="@style/Heading"
                    android:text="Today's classes" />

                <LinearLayout
                    android:id="@+id/todayList"
                    style="@style/Wide"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Heading"
                    android:text="Start an extra class" />

                <LinearLayout
                    android:id="@+id/adhocCard"
                    style="@style/Card">

                    <Spinner
                        android:id="@+id/gradeSpinner"
                        style="@style/Field" />

                    <Spinner
                        android:id="@+id/divisionSpinner"
                        style="@style/Field" />

                    <EditText
                        android:id="@+id/subjectInput"
                        style="@style/Field"
                        android:hint="Subject (optional)"
                        android:importantForAutofill="no"
                        android:inputType="textCapWords" />

                    <Button
                        android:id="@+id/adhocButton"
                        style="@style/Wide"
                        android:text="Start extra class" />
                </LinearLayout>

                <TextView
                    android:id="@+id/noGradesText"
                    style="@style/Body"
                    android:text="No grades are assigned to you yet. Ask the school admin."
                    android:visibility="gone" />

                <LinearLayout
                    style="@style/Wide"
                    android:orientation="horizontal"
                    android:paddingTop="12dp">

                    <Button
                        android:id="@+id/refreshButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Refresh" />

                    <Button
                        android:id="@+id/logoutButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Sign out" />
                </LinearLayout>
            </LinearLayout>

            <!-- In class -->
            <LinearLayout
                android:id="@+id/classGroup"
                style="@style/Wide"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/classTitle"
                    style="@style/Wide"
                    android:textColor="#F8FAFC"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/classStatus"
                    style="@style/Body"
                    android:paddingBottom="4dp"
                    android:textColor="#E2E8F0" />

                <LinearLayout
                    android:id="@+id/classColumns"
                    style="@style/Wide"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/controlsColumn"
                        style="@style/Wide"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/waitingCard"
                            style="@style/Card"
                            android:background="#422006"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/waitingText"
                                style="@style/Body"
                                android:textColor="#FDE68A"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/admitAllButton"
                                style="@style/Wide"
                                android:text="Admit all" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/shareButton"
                            style="@style/Wide"
                            android:layout_marginTop="8dp"
                            android:text="Share screen" />

                        <Button
                            android:id="@+id/stopShareButton"
                            style="@style/Wide"
                            android:text="Stop sharing"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/micButton"
                            style="@style/Wide"
                            android:text="Turn microphone on" />

                        <LinearLayout
                            style="@style/Wide"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/muteAllButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Mute all" />

                            <Button
                                android:id="@+id/unmuteAllButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="Allow unmute" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Wide"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/leaveButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Leave" />

                            <Button
                                android:id="@+id/endButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:backgroundTint="#B91C1C"
                                android:text="End class" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/chatColumn"
                        style="@style/Wide"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Heading"
                            android:text="Chat" />

                        <TextView
                            android:id="@+id/chatLog"
                            style="@style/Body"
                            android:background="#111827"
                            android:minHeight="120dp"
                            android:padding="10dp"
                            android:textColor="#E2E8F0" />

                        <EditText
                            android:id="@+id/chatInput"
                            style="@style/Field"
                            android:hint="Message everyone"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences"
                            android:maxLength="2000" />

                        <Button
                            android:id="@+id/sendButton"
                            style="@style/Wide"
                            android:text="Send" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- This device lost the class to another connection -->
            <LinearLayout
                android:id="@+id/handoffGroup"
                style="@style/Card"
                android:visibility="gone">

                <TextView
                    android:id="@+id/handoffTitle"
                    style="@style/Wide"
                    android:text="Class continued on another device"
                    android:textColor="#F8FAFC"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/handoffText"
                    style="@style/Body"
                    android:paddingTop="6dp"
                    android:paddingBottom="8dp"
                    android:text="This class was opened with your account on another device or tab, so this one was disconnected. The class itself carries on there." />

                <Button
                    android:id="@+id/useHereButton"
                    style="@style/Wide"
                    android:text="Use this device instead" />

                <Button
                    android:id="@+id/handoffHomeButton"
                    style="@style/Wide"
                    android:text="Back to classes" />
            </LinearLayout>

            <TextView
                android:id="@+id/errorText"
                style="@style/Body"
                android:paddingTop="12dp"
                android:textColor="#FCA5A5" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
