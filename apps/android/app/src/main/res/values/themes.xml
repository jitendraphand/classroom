<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ClassroomTeacher" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#2563EB</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:navigationBarColor">#0F172A</item>
        <item name="android:windowBackground">#0F172A</item>
        <item name="materialButtonStyle">@style/ClassButton</item>
    </style>

    <style name="ClassButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/btn_bg</item>
        <item name="android:textColor">@color/btn_text</item>
    </style>

    <style name="ClassButton.Danger">
        <item name="backgroundTint">@color/btn_danger_bg</item>
    </style>
</resources>
