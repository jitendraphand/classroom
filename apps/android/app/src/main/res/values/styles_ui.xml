<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#F8FAFC</item>
        <item name="android:textColorHint">#64748B</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Wide">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="Heading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">#E2E8F0</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#CBD5E1</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">#1E293B</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
</resources>
