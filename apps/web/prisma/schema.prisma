generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The single school administrator (bootstrapped by scripts/create-admin.sh /
/// the container entrypoint from ADMIN_EMAIL). Kept apart from Teacher so an
/// admin session can never be used as a teacher session and vice versa.
model Admin {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String   @default("Administrator")
  /// Set for a generated (bootstrap / reset) password: must change on first login.
  mustChangePassword Boolean  @default(true)
  /// Bumped on password change/reset; session JWTs carry it so old sessions die.
  sessionVersion     Int      @default(0)
  /// The one signed-in session (set on login, cleared on logout). A token with another id was replaced by a newer login.
  activeSessionId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Teacher {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  name               String
  /// Stable meeting code reused for every class this teacher starts.
  permanentCode      String              @unique
  /// Disabled teachers cannot sign in; existing sessions stop working.
  disabled           Boolean             @default(false)
  /// Admin-issued temporary password: the teacher must change it on first login.
  mustChangePassword Boolean             @default(false)
  /// Bumped on password change/reset/disable; session JWTs carry it.
  sessionVersion     Int                 @default(0)
  /// The one signed-in session (set on login, cleared on logout). A token with another id was replaced by a newer login.
  activeSessionId    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  rooms              Room[]
  assignments        TeacherAssignment[]
  slots              TimetableSlot[]
  overrides          ScheduleOverride[]
  classSessions      ClassSession[]
}

/// Grade/division a teacher may teach. division "*" = every division of the grade.
model TeacherAssignment {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  grade     String
  division  String

  @@unique([teacherId, grade, division])
  @@index([grade, division])
}

enum RoomStatus {
  WAITING
  LIVE
  ENDED
}

model Room {
  id               String         @id @default(cuid())
  code             String         @unique
  name             String
  teacherId        String
  teacher          Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  maxVisibleVideos Int            @default(6)
  status           RoomStatus     @default(WAITING)
  /// Rotated on every (re)open; part of the LiveKit room name so old tokens die with the session.
  sessionId        String         @default(cuid())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  endedAt          DateTime?
  /// ClassSession currently running in this (permanent) room, if any.
  classSessionId   String?
  participants     Participant[]
  messages         Message[]
  classSessions    ClassSession[]

  @@index([teacherId])
  @@index([status])
}

enum ParticipantRole {
  TEACHER
  STUDENT
}

enum ParticipantStatus {
  WAITING
  ADMITTED
  LEFT
}

model Participant {
  id               String            @id @default(cuid())
  roomId           String
  room             Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  displayName      String
  role             ParticipantRole   @default(STUDENT)
  status           ParticipantStatus @default(WAITING)
  livekitIdentity  String            @unique
  sessionToken     String            @unique
  mutedByTeacher   Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  leftAt           DateTime?
  /// Set for students who came through the signed school-app link.
  studentId        String?
  student          Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  /// ClassSession this participant joined (attendance).
  classSessionId   String?
  sentMessages     Message[]         @relation("MessageSender")
  receivedMessages Message[]         @relation("MessageRecipient")

  @@index([roomId, status])
  @@index([sessionToken])
  @@index([studentId])
}

enum MessageScope {
  TEACHER
  BROADCAST
  DIRECT
}

model Message {
  id                     String       @id @default(cuid())
  roomId                 String
  room                   Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderParticipantId    String
  sender                 Participant  @relation("MessageSender", fields: [senderParticipantId], references: [id], onDelete: Cascade)
  body                   String
  scope                  MessageScope
  recipientParticipantId String?
  recipient              Participant? @relation("MessageRecipient", fields: [recipientParticipantId], references: [id], onDelete: SetNull)
  createdAt              DateTime     @default(now())

  @@index([roomId, createdAt])
  @@index([senderParticipantId])
  @@index([recipientParticipantId])
}

/// Recurring weekly lesson. Times are minutes after local midnight in
/// APP_TIMEZONE (default Asia/Kolkata); weekday 0 = Sunday … 6 = Saturday.
model TimetableSlot {
  id            String             @id @default(cuid())
  teacherId     String
  teacher       Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  grade         String
  /// Combined divisions (e.g. ["A","B"]); ignored when allDivisions.
  divisions     String[]
  allDivisions  Boolean            @default(false)
  subject       String
  weekday       Int
  startMinute   Int
  endMinute     Int
  /// Optional inclusive local-date range (term dates).
  effectiveFrom DateTime?          @db.Date
  effectiveTo   DateTime?          @db.Date
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  overrides     ScheduleOverride[]
  sessions      ClassSession[]

  @@index([teacherId, weekday])
  @@index([grade, weekday])
}

enum OverrideKind {
  /// Slot does not happen on that date.
  CANCEL
  /// Slot happens with changes (substitute teacher, time, subject).
  MODIFY
  /// One-off extra class (no slot).
  EXTRA
}

/// One-off change to the timetable on one local date.
model ScheduleOverride {
  id           String         @id @default(cuid())
  kind         OverrideKind
  date         DateTime       @db.Date
  slotId       String?
  slot         TimetableSlot? @relation(fields: [slotId], references: [id], onDelete: Cascade)
  /// MODIFY: substitute teacher; EXTRA: the teacher.
  teacherId    String?
  teacher      Teacher?       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  /// EXTRA (and optionally MODIFY): audience.
  grade        String?
  divisions    String[]
  allDivisions Boolean        @default(false)
  subject      String?
  startMinute  Int?
  endMinute    Int?
  note         String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([slotId, date])
  @@index([date])
}

/// One held (or about-to-be-held) class: a timetable occurrence or an ad-hoc
/// class. Scheduled occurrences have a unique occurrenceKey so starting the
/// same class again that day reuses this row.
model ClassSession {
  id             String             @id @default(cuid())
  /// "slot:<slotId>:<YYYY-MM-DD>" or "extra:<overrideId>"; null for ad-hoc.
  occurrenceKey  String?            @unique
  slotId         String?
  slot           TimetableSlot?     @relation(fields: [slotId], references: [id], onDelete: SetNull)
  overrideId     String?
  /// Local (APP_TIMEZONE) date of the class.
  sessionDate    DateTime           @db.Date
  teacherId      String
  teacher        Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  roomId         String?
  room           Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  grade          String
  divisions      String[]
  allDivisions   Boolean            @default(false)
  subject        String
  adHoc          Boolean            @default(false)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  /// Set when the teacher starts the class (first start; kept on reopen).
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  attendance     AttendanceRecord[]

  @@index([teacherId, sessionDate])
  @@index([grade, sessionDate])
  @@index([sessionDate])
}

/// A student known from the external school app (first signed join) or an
/// admin roster import. externalId is the school app's permanent student id.
model Student {
  id           String             @id @default(cuid())
  externalId   String             @unique
  name         String
  grade        String
  division     String
  /// Display only.
  rollNumber   String?
  email        String?
  phone        String?
  /// "join" (signed link) or "import" (admin CSV).
  source       String             @default("join")
  lastSeenAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  participants Participant[]
  attendance   AttendanceRecord[]

  @@index([grade, division])
}

/// One student's attendance in one class session (across reconnects).
model AttendanceRecord {
  id             String       @id @default(cuid())
  classSessionId String
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// First arrival in the waiting room (or the pre-start lobby).
  firstJoinedAt  DateTime
  admittedAt     DateTime?
  leftAt         DateTime?
  /// Sum of closed media-connection intervals (union across reconnects).
  connectedMs    Int          @default(0)
  /// Start of the currently open interval (some connection is live).
  connectedSince DateTime?
  /// LiveKit participant SIDs currently connected.
  openSids       String[]
  connections    Int          @default(0)
  late           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([classSessionId, studentId])
  @@index([studentId])
}

/// Master list of grades (Admin → Grades & divisions). Other tables keep the
/// canonical grade string (no foreign key), so editing this list never rewrites
/// timetable, attendance or student history; it drives the admin dropdowns and
/// validation of new entries.
model Grade {
  id        String     @id @default(cuid())
  /// Canonical form (normalizeGrade): "7", "XII".
  name      String     @unique
  /// Display form ("7", "Grade 7", "KG").
  label     String
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  divisions Division[]

  @@index([sortOrder])
}

/// A division of a grade.
model Division {
  id        String   @id @default(cuid())
  gradeId   String
  grade     Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  /// Canonical form (normalizeDivision): upper-case, no spaces ("A", "MAHAVEER").
  name      String
  /// Display form ("A", "Mahaveer").
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gradeId, name])
}
