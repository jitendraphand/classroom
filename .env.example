# Classroom Online Teaching App — environment template
# Copy to .env: cp .env.example .env
#
# Local demo:
#   ./scripts/sync-livekit-keys.sh && docker compose up --build -d
#
# VPS / bare public IP (no domain), e.g. http://203.0.113.10:3000:
#   PUBLIC_IP=203.0.113.10 ./scripts/configure-public-ip.sh
#   ./scripts/sync-livekit-keys.sh && docker compose up --build -d
# See docs/DEPLOY-VPS.md
#
# VPS / domain + Caddy Let's Encrypt HTTPS (requires DNS A/AAAA → VM):
#   DOMAIN=class.example.com PUBLIC_IP=203.0.113.10 ACME_EMAIL=admin@example.com \
#     ./scripts/configure-domain-tls.sh
#   ./scripts/sync-livekit-keys.sh && docker compose --profile tls up --build -d
# See docs/DEPLOY-CADDY.md
# Let's Encrypt will NOT issue certs for a bare IP — use configure-public-ip.sh for that path.
#
# Compose uses host networking on a single Linux VM:
# - Browser-facing URLs must use the PUBLIC IP or DOMAIN (not localhost)
# - Server→Postgres/Redis/LiveKit stay on 127.0.0.1
#
# SECURITY: every secret below is a PLACEHOLDER. You normally do not edit them:
# scripts/sync-livekit-keys.sh (and configure-public-ip.sh / configure-domain-tls.sh /
# configure-sslip-tls.sh) replace any placeholder, the old `devkey` API key, or a
# value known to have leaked from this repo's history with fresh random values,
# written only to the untracked .env. ROTATE_SECRETS=1 forces new values.
# infra/livekit.yaml is generated from .env and is gitignored; never commit it.
# The web container refuses to start with placeholder / leaked secrets.
# Postgres is bound to 127.0.0.1 only; `docker compose` refuses to start without
# POSTGRES_PASSWORD.

POSTGRES_USER=classroom
# REQUIRED — generated by the setup scripts. Do not reuse the value from this template.
POSTGRES_PASSWORD=change-me-generate-a-random-password
POSTGRES_DB=classroom
DATABASE_URL=postgresql://classroom:change-me-generate-a-random-password@127.0.0.1:5432/classroom

REDIS_URL=redis://127.0.0.1:6379

# REQUIRED — the key/secret pair is an ADMIN credential for the LiveKit SFU (mint
# tokens for any room, delete rooms, remove participants). Generated by
# scripts/sync-livekit-keys.sh; `devkey` and placeholders are always replaced.
LIVEKIT_API_KEY=replace-with-generated-api-key
LIVEKIT_API_SECRET=replace-with-long-random-secret
# Server-side LiveKit (loopback; host networking)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
# Browser-facing LiveKit — ws://PUBLIC_IP:7880 on bare IP, or wss://livekit.DOMAIN with Caddy
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
# Discover / advertise the VM public IP for WebRTC ICE (true on VPS)
LIVEKIT_USE_EXTERNAL_IP=false
# Optional: pin advertised IP if STUN discovery fails (set by configure-*-ip/tls scripts)
# LIVEKIT_NODE_IP=203.0.113.10
# LIVEKIT_PUBLIC_PORT=7880

NEXTAUTH_SECRET=change-me-to-a-long-random-string-in-production
# Browser-facing app URL — http://PUBLIC_IP:3000 (bare IP) or https://DOMAIN (Caddy TLS)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Cookie Secure: false for HTTP (including bare public IP); true only behind HTTPS
# COOKIE_SECURE=false

# --- Optional: domain + Caddy TLS (scripts/configure-domain-tls.sh) ---
# DOMAIN=class.example.com
# PUBLIC_IP=203.0.113.10
# ACME_EMAIL=admin@example.com
# LIVEKIT_HOST=livekit.class.example.com
# Then: docker compose --profile tls up -d
# APP_URL=https://class.example.com
# NEXT_PUBLIC_APP_URL=https://class.example.com
# NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.class.example.com
# COOKIE_SECURE=true

MAX_VISIBLE_STUDENT_VIDEOS=6
SAMPLE_ROTATION_SECONDS=8
# Deprecated: pins now stick until mute (kept for backward-compat; unused for expiry)
SPEAKER_PIN_TTL_SECONDS=18

NODE_ENV=production

# Free IP hostname TLS (no registrar): PUBLIC_IP=x.x.x.x ./scripts/configure-sslip-tls.sh
# → https://x-x-x-x.sslip.io and wss://livekit.x-x-x-x.sslip.io
