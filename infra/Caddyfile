# Caddy reverse proxy + automatic HTTPS (Let's Encrypt).
# Generated/updated by: scripts/configure-domain-tls.sh or scripts/configure-sslip-tls.sh
#
# Own domain:  DOMAIN=class.example.com PUBLIC_IP=… ./scripts/configure-domain-tls.sh
# Free IP DNS: PUBLIC_IP=81.223.254.76 ./scripts/configure-sslip-tls.sh
#              → https://81-223-254-76.sslip.io + wss://livekit.81-223-254-76.sslip.io
#
# Compose: docker compose --profile tls up -d
# Ports 80/443 public; do NOT expose :3000/:7880 publicly when using Caddy
# LiveKit media stays direct: TCP 7881 + UDP 50000–50100

{
	# email admin@example.com
}

example.com {
	encode zstd gzip
	# Hashed build assets never change: cache for a year.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	# Other static files: a day (unless the app set its own).
	@assets path /favicon.ico /favicon.svg /*.png /*.jpg /*.svg /*.webp /*.woff2 /*.ico
	header @assets ?Cache-Control "public, max-age=86400"
	# API answers are per user and live: never cached (unless the route says otherwise).
	@api path /api/*
	header @api ?Cache-Control "no-store"
	reverse_proxy 127.0.0.1:3000
}

livekit.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:7880
}
